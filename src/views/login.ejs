<%- include('includes/head.ejs') %>

<%- include('includes/nav.ejs') %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
            <h1 class="text-center my-3"> Criar conta ou fazer o Login</h1>
            <p class="text-center lead">Faça seu login ou crie sua conta</p>
            <%- include('includes/menssages')%>

            <div class="row">

                <div class="col-lg text-center">
                    <h3 class="">Cadastre-se</h3>
                    <p>Crie sua conta para ter acesso as funções do site</p>
                    <form action="/login/register" method="POST">
                    <input type="hidden" name="_csrf" value="<%=csrf%>">
                        <div class="mb-3">
                            <label>Seu e-mail</label>
                            <input type="email" class="form-control" name="email">
                        </div>
                        <div class="mb-3">
                            <label for="exampleInputPassword1" class="form-label">Sua senha</label>
                            <input type="password" class="form-control" id="exampleInputPassword1" name="password">
                        </div>
                        <button type="submit" class="btn btn-primary">Criar conta</button>
                    </form>
                </div>

                <div class="col-lg text-center">
                    <h3 class="">Faça o Login</h3>
                    <p>Faça seu login para ter acesso as funções do site</p>
                    
                    

                    <form action="/login/login" method="POST">
                    <input type="hidden" name="_csrf" value="<%=csrf%>">
                        <div class="mb-3">
                            <label>E-mail</label>
                            <input type="email" class="form-control" name="email">
                        </div>
                        <div class="mb-3">
                            <label for="exampleInputPassword1" class="form-label" >Senha</label>
                            <input type="password" class="form-control" id="exampleInputPassword1" name="password">
                        </div>
                        <button type="submit" class="btn btn-primary">Login</button>
                    </form>
                </div>

            </div>

           
        </div>

        <div class="col-lg-2"></div>
    </div>
</div>
<%- include('includes/footer.ejs') %>
    