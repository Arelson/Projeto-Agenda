<%- include('includes/head.ejs') %>

<%- include('includes/nav.ejs') %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
            <h1 class="text-center my-3"> Agenda</h1>
            <p class="text-center lead">Seus contatos</p>

            <%if (!user) {%>
                <div class="row">
                    <div class="col">
                        <div class="alert alert-info" role="alert">
                            Precisa esta logado para fazer as alterações
                        </div>
                    </div>
                </div>
            <%}%>
           <%- include('includes/menssages')%>

            <div class="responsive-table">
                <table class="table my-3">
                    <% contatos.forEach( contato => {%>
                        <tr>
                            <td><%= contato.nome%></td>
                            <td><%= contato.sobrenome%> </td>
                            <td><%= contato.email%> </td>
                            <td><%= contato.tel%> </td>
                            <td> <a  class="text-decoration-none" href="/contato/index/<%=contato._id%>">Editar</a></td>
                            <td> <a  class="text-danger text-decoration-none" href="/contato/delete/<%=contato._id%>">Deletar</a></td>
                        </tr>
                    <%})%>
                </table>
            </div>
        </div>

        <div class="col-lg-2"></div>
    </div>
</div>
<%- include('includes/footer.ejs') %>
    